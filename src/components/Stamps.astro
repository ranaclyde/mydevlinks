---
import type { Link } from '../lib/links';

interface Props {
	status: Link['status'];
	verified: boolean;
	/** Clases extra de cada sello (por ejemplo, su margen dentro de la ficha). */
	class?: string;
}

const { status, verified, class: extra } = Astro.props;

const down = status === 'caido';
const old = status === 'antiguo';

const stampBase =
	'inline-flex flex-none items-center gap-1 border border-current px-1.5 py-0.5 font-mono text-[11px] font-semibold tracking-[.06em] whitespace-nowrap uppercase';
---

{
	old && (
		<span class:list={[stampBase, 'text-old bg-old-bg', extra]}>
			<svg
				width="11"
				height="11"
				viewBox="0 0 12 12"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				aria-hidden="true"
			>
				<circle cx="6" cy="6" r="4.6" />
				<path d="M6 3.5V6l1.7 1.2" />
			</svg>
			Antiguo
		</span>
	)
}
{
	down && (
		<span class:list={[stampBase, 'text-down bg-down-bg', extra]}>
			<svg
				width="11"
				height="11"
				viewBox="0 0 12 12"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				aria-hidden="true"
			>
				<circle cx="6" cy="6" r="4.6" />
				<path d="M2.8 9.2l6.4-6.4" />
			</svg>
			Caído
		</span>
	)
}
{
	!verified && !down && (
		<span class:list={[stampBase, 'text-muted bg-surface', extra, 'border-dashed']}>
			<svg
				width="11"
				height="11"
				viewBox="0 0 12 12"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				aria-hidden="true"
			>
				<circle cx="6" cy="6" r="4.6" stroke-dasharray="2 1.6" />
				<path d="M4.8 4.8a1.3 1.3 0 1 1 1.8 1.2c-.4.2-.6.5-.6.9M6 8.6v.1" />
			</svg>
			Sin verificar
		</span>
	)
}
