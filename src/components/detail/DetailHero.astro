---
import { domainOf, type Link } from '../../lib/links';
import Stamps from '../Stamps.astro';

interface Props {
	link: Link;
}

const { link } = Astro.props;
const { name, url, description, tech, tags = [], logo, status, verified } = link;

const down = status === 'caido';
const domain = domainOf(url);
const initial = [...name.trim()][0]?.toUpperCase() ?? '?';
const techs = verified ? tech : [];
const chips = [...techs, ...tags];
/** Chips visibles antes de "+N"; el resto se despliega con el botón. */
const VISIBLE_CHIPS = 4;
const hidden = chips.length - VISIBLE_CHIPS;

const text = verified
	? description
	: down
		? 'Sin descripción: el sitio no responde.'
		: 'Todavía sin descripción ni tecnologías.';

const button =
	'inline-flex min-h-11 items-center justify-center gap-2 border px-4 text-sm font-medium no-underline transition-colors duration-100 hover:bg-accent hover:border-accent hover:text-accent-ink max-[520px]:flex-auto md:min-h-10';
---

<div
	class="ficha ficha-fija bg-surface grid grid-cols-[64px_minmax(0,1fr)] items-start gap-4 px-[22px] pt-5 pb-[18px] max-[520px]:grid-cols-1 max-[520px]:gap-3 max-[520px]:p-4"
>
	<span
		class:list={[
			'bg-plate border-line relative grid size-16 place-items-center overflow-hidden border max-[520px]:size-12',
			{ 'opacity-55 grayscale': down },
		]}
		aria-hidden="true"
	>
		<span class="text-plate-ink font-mono text-2xl font-semibold">{initial}</span>
		{
			logo && (
				<img
					class="bg-plate absolute inset-0 size-full object-contain p-3 max-[520px]:p-2.5"
					src={logo}
					alt=""
					width="64"
					height="64"
					decoding="async"
					onerror="this.remove()"
				/>
			)
		}
	</span>

	<div class="min-w-0">
		<div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
			<div class="flex min-w-0 flex-[1_1_12em] flex-col">
				<h1
					class="text-[26px] leading-[1.15] font-semibold tracking-[-.01em] wrap-anywhere max-[520px]:text-[22px]"
				>
					{name}
				</h1>
				<span class="text-muted mt-0.5 font-mono text-[11px] tracking-[.02em] wrap-anywhere">
					{domain}
				</span>
			</div>
			<div class="flex flex-wrap gap-1.5">
				<Stamps status={status} verified={verified} />
			</div>
		</div>

		<p class:list={['mt-2.5 max-w-[62ch] text-base', { 'text-muted italic': !verified }]}>
			{text}
		</p>

		<div class="mt-4 flex flex-wrap gap-2.5">
			<a
				class:list={[button, 'bg-ink text-bg border-ink']}
				href={url}
				target="_blank"
				rel="noopener noreferrer"
			>
				Visitar {domain}
				<span aria-hidden="true">↗</span>
				<span class="sr-only">(abre en otra pestaña)</span>
			</a>
			<a class:list={[button, 'bg-bg text-ink border-line-strong']} href="/" data-back>
				Volver al directorio
			</a>
		</div>

		{
			chips.length > 0 && (
				<>
					{techs.length > 0 && <span class="sr-only">Tecnologías: {techs.join(', ')}.</span>}
					{tags.length > 0 && <span class="sr-only">Tipo: {tags.join(', ')}.</span>}
					<div
						class="border-line mt-3.5 flex flex-wrap gap-1.5 border-t border-dashed pt-3"
						data-hero-chips
					>
						{chips.map((chip, index) => (
							<span class="chip" aria-hidden="true" data-extra={index >= VISIBLE_CHIPS ? '' : undefined}>
								{chip}
							</span>
						))}
						{hidden > 0 && (
							<button
								class="chip chip-toggle"
								type="button"
								aria-expanded="false"
								aria-label={`Ver ${hidden} tecnologías más`}
								data-chips-toggle
								data-needs-js
							>
								+{hidden}
							</button>
						)}
					</div>
				</>
			)
		}
	</div>
</div>
