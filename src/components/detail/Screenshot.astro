---
import { Image } from 'astro:assets';
import { formatDate } from '../../lib/details';
import { useTranslations } from '../../i18n/ui';
import { domainOf, type Link } from '../../lib/links';
import { screenshotOf } from '../../lib/screenshots';

interface Props {
	link: Link;
	/** Fecha ISO de la captura; sin ella no hay imagen. */
	screenshotAt?: string;
}

const { link, screenshotAt } = Astro.props;
const domain = domainOf(link.url);
const t = useTranslations(Astro.currentLocale);
const image = screenshotAt ? screenshotOf(link.id) : undefined;
/**
 * Ancho que ocupa en la ficha: la columna principal (hasta ~800 px junto a la barra de 300 px)
 * o el ancho de la pantalla menos el margen en móvil.
 */
const sizes = '(min-width: 48rem) min(800px, calc(100vw - 360px)), calc(100vw - 32px)';
---

{
	image && screenshotAt ? (
		<figure class="border-line bg-surface m-0 border">
			<figcaption class="border-line text-muted flex items-center justify-between gap-3 border-b px-2.5 py-1.5 font-mono text-[11px]">
				<span class="truncate">{domain}</span>
				<span class="flex-none">{t.screenshotFrom(formatDate(screenshotAt, t.dateLocale))}</span>
			</figcaption>
			<Image
				class="block h-auto w-full"
				src={image}
				alt={t.screenshotOf(domain)}
				format="webp"
				widths={[480, 800, 1280]}
				sizes={sizes}
				quality={70}
				loading="lazy"
				decoding="async"
			/>
		</figure>
	) : (
		link.status === 'down' && (
			<p class="border-line-strong text-muted border border-dashed px-6 py-9 text-sm">
				{t.noScreenshot}
			</p>
		)
	)
}
