---
import { localizePath, toLocale, useTranslations } from '../../i18n/ui';
import { formatDate, type Detail } from '../../lib/details';
import { domainOf, type Link } from '../../lib/links';
import { stateToSearch } from '../../lib/url-state';

interface Props {
	link: Link;
	detail: Detail;
}

const { link, detail } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const categoryHref = localizePath('/', locale) + stateToSearch({ query: '', category: link.category, tech: [], tag: null });
const term = 'text-muted font-mono text-[11px] leading-[1.9] max-md:not-first:mt-2';
const action =
	'text-[13px] underline underline-offset-3 hover:text-accent transition-colors duration-100';
---

<div class="card card-static bg-surface px-[18px] py-4">
	<h2 class="mb-2 text-[15px] leading-[1.3] font-semibold">{t.techSheet}</h2>
	<dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-3.5 gap-y-[9px] text-[13.5px] max-md:grid-cols-1 max-md:gap-y-0">
		<dt class={term}>{t.price}</dt>
		<dd>
			<span
				class="price inline-flex items-center px-1.5 py-0.5 font-mono text-[11px] font-semibold tracking-[.06em] uppercase"
				data-price={detail.pricing}
			>
				{t.pricing[detail.pricing]}
			</span>
			{detail.pricingNote && <p class="text-muted mt-1 text-[13px]">{detail.pricingNote}</p>}
		</dd>
		{
			detail.pricingUrl && (
				<>
					<dt class={term}>{t.plans}</dt>
					<dd>
						<a class={action} href={detail.pricingUrl} target="_blank" rel="noopener noreferrer">
							{t.seePricing(domainOf(detail.pricingUrl))}
							<span aria-hidden="true">↗</span>
							<span class="sr-only">{t.opensInNewTab}</span>
						</a>
					</dd>
				</>
			)
		}
		<dt class={term}>{t.idealFor}</dt>
		<dd>{detail.idealFor}</dd>
		<dt class={term}>{t.category}</dt>
		<dd><a class={action} href={categoryHref}>{t.categories[link.category]}</a></dd>
	</dl>
	<p class="border-line mt-3.5 border-t border-dashed pt-3 text-[13px]">
		{t.lastReview} <span class="font-mono text-xs">{formatDate(detail.reviewedAt, t.dateLocale)}</span>
	</p>
	{
		!detail.reviewedByAuthor && (
			<p class="border-line-strong text-muted mt-3 flex gap-2 border border-dashed px-[11px] py-[9px] text-[12.5px]">
				<svg
					class="mt-0.5 flex-none"
					width="12"
					height="12"
					viewBox="0 0 12 12"
					fill="none"
					stroke="currentColor"
					stroke-width="1.4"
					aria-hidden="true"
				>
					<circle cx="6" cy="6" r="5" />
					<path d="M4.6 4.6a1.5 1.5 0 1 1 1.9 1.4c-.4.2-.5.4-.5.8M6 8.6v.1" />
				</svg>
				<span>{t.generated}</span>
			</p>
		)
	}
</div>
