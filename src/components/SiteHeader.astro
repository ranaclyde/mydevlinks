---
import { LOCALE_NAME, LOCALES, localizePath, toLocale, useTranslations } from '../i18n/ui';
import Flag from './Flag.astro';
import Logo from './Logo.astro';

interface Props {
	total: number;
	/** Ruta de la página en español; el selector de idioma lleva a la misma página en el otro. */
	path?: string;
	asHeading?: boolean;
	animateLogo?: boolean;
}

const { total, path = '/', asHeading = false, animateLogo = true } = Astro.props;
const Brand = asHeading ? 'h1' : 'p';
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const home = localizePath('/', locale);
const languages = LOCALES.map((lang) => ({
	lang,
	href: localizePath(path, lang),
	current: lang === locale,
}));

const themes = [
	{
		value: 'system',
		label: t.themeSystem,
		icon: '<rect x="2" y="3" width="12" height="8.5"/><path d="M6 14h4M8 11.5V14"/>',
	},
	{
		value: 'light',
		label: t.themeLight,
		icon: '<circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.8M8 12.7v1.8M1.5 8h1.8M12.7 8h1.8M3.4 3.4l1.3 1.3M11.3 11.3l1.3 1.3M3.4 12.6l1.3-1.3M11.3 4.7l1.3-1.3"/>',
	},
	{
		value: 'dark',
		label: t.themeDark,
		icon: '<path d="M13.2 10.1A5.6 5.6 0 0 1 5.9 2.8a5.6 5.6 0 1 0 7.3 7.3z"/>',
	},
];

/* Los dos selectores comparten forma: un disparador con lo elegido y una lista flotante. */
const trigger =
	'border-line-strong bg-bg text-ink hover:bg-sunk flex h-10 cursor-pointer list-none items-center gap-1.5 border px-2.5 md:h-8 md:px-2 [&::-webkit-details-marker]:hidden';
const chevron = 'text-muted transition-transform duration-150 group-open/menu:rotate-180 motion-reduce:transition-none';
const panel =
	'border-line-strong bg-bg absolute top-[calc(100%+4px)] right-0 z-30 flex min-w-44 flex-col border py-1';
const option =
	'text-muted hover:bg-sunk hover:text-ink aria-[current]:text-accent aria-pressed:text-accent group/option flex h-10 w-full cursor-pointer items-center gap-2.5 px-3 text-sm no-underline md:h-8';
/* El ícono del disparador sale de `data-theme`, que el layout fija antes de pintar: no parpadea. */
const summaryIcon: Record<string, string> = {
	system: '[:root[data-theme]_&]:hidden',
	light: 'hidden [:root[data-theme=light]_&]:block',
	dark: 'hidden [:root[data-theme=dark]_&]:block',
};
const check = 'invisible shrink-0 group-aria-[current]/option:visible group-aria-pressed/option:visible';
---

<header
	class="frame bg-surface border-line flex items-center justify-between gap-3 border-b px-4 py-3 md:sticky md:top-0 md:z-20 md:h-[58px]"
>
	<div class="flex items-center gap-3">
		<Brand class="font-mono text-lg leading-none font-semibold tracking-[-.02em]">
			<a href={home} class="text-inherit no-underline">
				<span class="sr-only">toolshelf</span>
				<span aria-hidden="true"><Logo animate={animateLogo} /></span>
			</a>
		</Brand>
		<span class="text-muted font-mono text-xs max-md:hidden">{total} {t.links(total)}</span>
	</div>
	<div class="flex items-center gap-2">
		<details class="group/menu relative" data-menu>
			<summary class={trigger} aria-label={`${t.language}: ${LOCALE_NAME[locale]}`}>
				<Flag lang={locale} />
				<span class="font-mono text-xs uppercase" aria-hidden="true">{locale}</span>
				<svg class={chevron} width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
					<path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4" />
				</svg>
			</summary>
			<nav class={panel} aria-label={t.language}>
				{
					languages.map((language) => (
						<a
							class={option}
							href={language.href}
							hreflang={language.lang}
							lang={language.lang}
							aria-current={language.current ? 'true' : undefined}
							data-lang-link
						>
							<Flag lang={language.lang} />
							<span class="flex-1">{LOCALE_NAME[language.lang]}</span>
							<svg class={check} width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
								<path d="M2.5 6.2l2.3 2.3 4.7-4.9" fill="none" stroke="currentColor" stroke-width="1.5" />
							</svg>
						</a>
					))
				}
			</nav>
		</details>
		<details class="group/menu relative" data-menu data-needs-js>
			<summary class={trigger} aria-label={t.theme} data-label={t.theme} data-theme-summary>
				{
					themes.map((theme) => (
						<svg
							class={summaryIcon[theme.value]}
							width="15"
							height="15"
							viewBox="0 0 16 16"
							fill="none"
							stroke="currentColor"
							stroke-width="1.4"
							aria-hidden="true"
							set:html={theme.icon}
						/>
					))
				}
				<svg class={chevron} width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
					<path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4" />
				</svg>
			</summary>
			<div class={panel} role="group" aria-label={t.theme}>
				{
					themes.map((theme) => (
						<button
							class={option}
							type="button"
							aria-pressed={theme.value === 'system' ? 'true' : 'false'}
							data-theme-button={theme.value}
						>
							<svg
								class="shrink-0"
								width="15"
								height="15"
								viewBox="0 0 16 16"
								fill="none"
								stroke="currentColor"
								stroke-width="1.4"
								aria-hidden="true"
								set:html={theme.icon}
							/>
							<span class="flex-1 text-left">{theme.label}</span>
							<svg class={check} width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
								<path d="M2.5 6.2l2.3 2.3 4.7-4.9" fill="none" stroke="currentColor" stroke-width="1.5" />
							</svg>
						</button>
					))
				}
			</div>
		</details>
	</div>
</header>

<script>
	import '../scripts/menus';

	// En el directorio, el otro idioma conserva los filtros de la URL.
	for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-lang-link]:not([aria-current])')) {
		link.addEventListener('click', () => {
			if (location.search) link.search = location.search;
		});
	}
</script>
