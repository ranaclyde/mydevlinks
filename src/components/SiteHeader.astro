---
interface Props {
	total: number;
	asHeading?: boolean;
	animateLogo?: boolean;
}

const { total, asHeading = false, animateLogo = true } = Astro.props;
const Brand = asHeading ? 'h1' : 'p';

const themes = [
	{
		value: 'system',
		label: 'Tema del sistema',
		icon: '<rect x="2" y="3" width="12" height="8.5"/><path d="M6 14h4M8 11.5V14"/>',
	},
	{
		value: 'light',
		label: 'Modo claro',
		icon: '<circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.8M8 12.7v1.8M1.5 8h1.8M12.7 8h1.8M3.4 3.4l1.3 1.3M11.3 11.3l1.3 1.3M3.4 12.6l1.3-1.3M11.3 4.7l1.3-1.3"/>',
	},
	{
		value: 'dark',
		label: 'Modo oscuro',
		icon: '<path d="M13.2 10.1A5.6 5.6 0 0 1 5.9 2.8a5.6 5.6 0 1 0 7.3 7.3z"/>',
	},
];
---

<header
	class="marco bg-surface border-line flex items-center justify-between gap-3 border-b px-4 py-3 md:sticky md:top-0 md:z-20 md:h-[58px]"
>
	<div class="flex items-baseline gap-3">
		<Brand class="font-mono text-lg leading-none font-semibold tracking-[-.02em]">
			<a href="/" class="text-inherit no-underline">
				<span class="sr-only">mydevlinks</span>
				<span aria-hidden="true"
					>mydev<span class:list={['logo-hit', { 'logo-static': !animateLogo }]}
						>{[...'links'].map((letter) => <span>{letter}</span>)}</span
					></span
				>
			</a>
		</Brand>
		<span class="text-muted font-mono text-xs max-md:hidden">{total} enlaces</span>
	</div>
	<div class="border-line flex border" role="group" aria-label="Tema" data-needs-js>
		{
			themes.map((theme) => (
				<button
					class="text-muted hover:bg-sunk hover:text-ink aria-pressed:bg-ink aria-pressed:text-bg border-line grid size-10 cursor-pointer place-items-center not-first:border-l md:h-8 md:w-9"
					type="button"
					aria-label={theme.label}
					aria-pressed={theme.value === 'system' ? 'true' : 'false'}
					data-theme-button={theme.value}
				>
					<svg
						width="15"
						height="15"
						viewBox="0 0 16 16"
						fill="none"
						stroke="currentColor"
						stroke-width="1.4"
						aria-hidden="true"
						set:html={theme.icon}
					/>
				</button>
			))
		}
	</div>
</header>
