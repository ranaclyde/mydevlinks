---
import { VISIBLE_TECH } from '../lib/filter';
import { domainOf, type Link } from '../lib/links';

interface Props {
	link: Link;
}

const { link } = Astro.props;
const { name, url, description, category, tech, tags = [], logo, status, verified, featured } = link;

const down = status === 'caido';
const old = status === 'antiguo';
const showChips = verified && tech.length > 0;
const initial = [...name.trim()][0]?.toUpperCase() ?? '?';

const text = verified
	? description
	: down
		? 'Sin descripción: el sitio no responde.'
		: 'Todavía sin descripción ni tecnologías.';

const stampBase =
	'inline-flex flex-none items-center gap-1 border border-current px-1.5 py-0.5 font-mono text-[11px] font-semibold tracking-[.06em] whitespace-nowrap uppercase';
---

<li
	data-card
	data-name={name}
	data-description={description}
	data-category={category}
	data-tech={JSON.stringify(tech)}
	data-tags={JSON.stringify(tags)}
>
	<a
		class:list={[
			'ficha group bg-surface text-ink grid h-full grid-cols-[40px_minmax(0,1fr)] grid-rows-[auto_1fr_auto] gap-x-3 gap-y-2.5 pt-3.5 pr-4 pb-3 pl-3.5 no-underline',
			{ 'f-unv': !verified },
		]}
		href={url}
		target="_blank"
		rel="noopener noreferrer"
	>
		<span
			class:list={[
				'bg-plate border-line relative grid size-10 place-items-center overflow-hidden border',
				{ 'opacity-55 grayscale': down },
			]}
			aria-hidden="true"
		>
			<span class="text-plate-ink font-mono text-[17px] font-semibold">{initial}</span>
			{
				logo && (
					<img
						class="bg-plate absolute inset-0 size-full object-contain p-1.5"
						src={logo}
						alt=""
						width="40"
						height="40"
						loading="lazy"
						decoding="async"
						onerror="this.remove()"
					/>
				)
			}
		</span>

		<div class="flex min-w-0 flex-wrap items-start justify-between gap-x-2 gap-y-1.5">
			<div class="flex min-w-0 flex-[1_1_9em] flex-col">
				<h3
					class="flex items-start gap-1 text-base leading-[1.3] font-semibold wrap-anywhere decoration-1 underline-offset-3 group-hover:underline"
				>
					<span class="line-clamp-2" title={name}>{name}</span>
					<svg
						class="text-muted group-hover:text-accent mt-1 flex-none transition-[transform,color] duration-100 group-hover:translate-x-px group-hover:-translate-y-px"
						width="12"
						height="12"
						viewBox="0 0 12 12"
						fill="none"
						stroke="currentColor"
						stroke-width="1.6"
						aria-hidden="true"><path d="M3.5 8.5l5-5M4.5 3.5h4v4"></path></svg
					>
				</h3>
				<span class="text-muted mt-0.5 truncate font-mono text-[11px] tracking-[.02em]">
					{domainOf(url)}
				</span>
			</div>

			{
				featured && (
					<span class:list={[stampBase, 'text-ink bg-surface mr-1.5']}>
						<svg
							width="11"
							height="11"
							viewBox="0 0 12 12"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M6 1.6l1.35 2.75 3.03.44-2.19 2.13.52 3.02L6 8.52 3.29 9.94l.52-3.02L1.62 4.79l3.03-.44z" />
						</svg>
						Destacado
					</span>
				)
			}
			{
				old && (
					<span class:list={[stampBase, 'text-old bg-old-bg mr-1.5']}>
						<svg
							width="11"
							height="11"
							viewBox="0 0 12 12"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							aria-hidden="true"
						>
							<circle cx="6" cy="6" r="4.6" />
							<path d="M6 3.5V6l1.7 1.2" />
						</svg>
						Antiguo
					</span>
				)
			}
			{
				down && (
					<span class:list={[stampBase, 'text-down bg-down-bg mr-1.5']}>
						<svg
							width="11"
							height="11"
							viewBox="0 0 12 12"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							aria-hidden="true"
						>
							<circle cx="6" cy="6" r="4.6" />
							<path d="M2.8 9.2l6.4-6.4" />
						</svg>
						Caído
					</span>
				)
			}
			{
				!verified && !down && (
					<span class:list={[stampBase, 'text-muted bg-surface mr-1.5 border-dashed']}>
						<svg
							width="11"
							height="11"
							viewBox="0 0 12 12"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							aria-hidden="true"
						>
							<circle cx="6" cy="6" r="4.6" stroke-dasharray="2 1.6" />
							<path d="M4.8 4.8a1.3 1.3 0 1 1 1.8 1.2c-.4.2-.6.5-.6.9M6 8.6v.1" />
						</svg>
						Sin verificar
					</span>
				)
			}
		</div>

		<p
			title={text}
			class:list={[
				'col-span-full line-clamp-2 text-sm leading-[1.45]',
				{ 'text-muted italic': !verified, 'text-muted': verified && down },
			]}
		>
			{text}
		</p>

		{
			showChips && (
				<>
					<span class="sr-only">Tecnologías: {tech.join(', ')}.</span>
					<div
						class="border-line col-span-full flex flex-wrap gap-[5px] border-t border-dashed pt-2.5"
						aria-hidden="true"
						data-chips
					>
						{tech.slice(0, VISIBLE_TECH).map((item) => (
							<span class="chip" data-chip={item}>
								{item}
							</span>
						))}
						{tech.length > VISIBLE_TECH && (
							<>
								<span class="chip more" data-more>
									+{tech.length - VISIBLE_TECH}
								</span>
								<span class="chips-rest" data-rest>
									{tech.slice(VISIBLE_TECH).map((item) => (
										<span class="chip" data-chip={item}>
											{item}
										</span>
									))}
								</span>
							</>
						)}
					</div>
				</>
			)
		}
		{
			tags.length > 0 && (
				<>
					<span class="sr-only">Tipo: {tags.join(', ')}.</span>
					<div
						class="border-line col-span-full flex flex-wrap gap-[5px] border-t border-dashed pt-2.5"
						aria-hidden="true"
					>
						{tags.map((tag) => (
							<span class="chip" data-tag={tag}>
								{tag}
							</span>
						))}
					</div>
				</>
			)
		}
		<span class="sr-only"> (abre en otra pestaña)</span>
	</a>
</li>
