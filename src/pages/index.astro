---
import { getCollection } from 'astro:content';
import Filters from '../components/Filters.astro';
import LinkCard from '../components/LinkCard.astro';
import Layout from '../layouts/Layout.astro';
import { visibleLinks } from '../lib/links';

const collection = await getCollection('links');
const links = visibleLinks(
	collection.map((entry) => entry.data),
	import.meta.env.DEV,
).sort((a, b) => a.name.localeCompare(b.name, 'es', { sensitivity: 'base' }));

function tally(values: string[]) {
	const counts = new Map<string, number>();
	for (const value of values) counts.set(value, (counts.get(value) ?? 0) + 1);
	return [...counts]
		.map(([value, count]) => ({ value, count }))
		.sort((a, b) => b.count - a.count || a.value.localeCompare(b.value, 'es'));
}

const categories = tally(links.map((link) => link.category));
const techs = tally(links.flatMap((link) => link.tech));
const tags = tally(links.flatMap((link) => link.tags ?? []));

const themes = [
	{
		value: 'system',
		label: 'Tema del sistema',
		icon: '<rect x="2" y="3" width="12" height="8.5"/><path d="M6 14h4M8 11.5V14"/>',
	},
	{
		value: 'light',
		label: 'Modo claro',
		icon: '<circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.8M8 12.7v1.8M1.5 8h1.8M12.7 8h1.8M3.4 3.4l1.3 1.3M11.3 11.3l1.3 1.3M3.4 12.6l1.3-1.3M11.3 4.7l1.3-1.3"/>',
	},
	{
		value: 'dark',
		label: 'Modo oscuro',
		icon: '<path d="M13.2 10.1A5.6 5.6 0 0 1 5.9 2.8a5.6 5.6 0 1 0 7.3 7.3z"/>',
	},
];
---

<Layout>
	<a
		class="bg-ink text-bg sr-only top-2 left-2 z-30 px-3 py-2 text-sm font-medium focus:not-sr-only focus:fixed"
		href="#resultados">Saltar a resultados</a
	>

	<header
		class="bg-surface border-line flex items-center justify-between gap-3 border-b px-4 py-3 md:sticky md:top-0 md:z-20 md:h-[58px]"
	>
		<div class="flex items-baseline gap-3">
			<h1
				class="inline-flex items-center gap-2 font-mono text-lg font-semibold tracking-[-.02em]"
			>
				<svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<path d="M.75.75h7l3.5 3.5v7H.75z"></path>
				</svg>
				mydevlinks
			</h1>
			<span class="text-muted font-mono text-xs max-md:hidden">{links.length} enlaces</span>
		</div>
		<div class="border-line flex border" role="group" aria-label="Tema" data-needs-js>
			{
				themes.map((theme) => (
					<button
						class="text-muted hover:bg-sunk hover:text-ink aria-pressed:bg-ink aria-pressed:text-bg border-line grid size-10 cursor-pointer place-items-center not-first:border-l md:h-8 md:w-9"
						type="button"
						aria-label={theme.label}
						aria-pressed={theme.value === 'system' ? 'true' : 'false'}
						data-theme-button={theme.value}
					>
						<svg
							width="15"
							height="15"
							viewBox="0 0 16 16"
							fill="none"
							stroke="currentColor"
							stroke-width="1.4"
							aria-hidden="true"
							set:html={theme.icon}
						/>
					</button>
				))
			}
		</div>
	</header>

	<div class="grid items-start md:grid-cols-[264px_minmax(0,1fr)]" data-app>
		<Filters categories={categories} techs={techs} tags={tags} total={links.length} />

		<main class="flex min-w-0 flex-col gap-3.5 px-4 pt-3.5 pb-7 md:px-5 md:pt-4 md:pb-8">
			<div class="flex min-h-10 flex-wrap items-center gap-x-4 gap-y-2.5">
				<h2
					class="text-muted flex w-fit items-baseline gap-2 text-sm font-normal"
					id="resultados"
					tabindex="-1"
				>
					<span
						class="text-ink font-mono text-[26px] leading-none font-semibold tabular-nums"
						data-count-value>{links.length}</span
					>
					<span data-count-label>enlaces</span>
				</h2>
				<div class="flex min-w-0 flex-wrap items-center gap-1.5" data-actives></div>
			</div>
			<p class="sr-only" role="status" data-live></p>

			<noscript>
				<p class="text-muted text-sm">
					Sin JavaScript no hay filtros, pero están todos los enlaces.
				</p>
			</noscript>

			<ul
				class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(min(270px,100%),1fr))] gap-3 p-0 max-md:grid-cols-1"
				data-grid
			>
				{links.map((link) => <LinkCard link={link} />)}
			</ul>

			<div
				class="border-line-strong bg-surface flex max-w-[640px] flex-col items-start gap-2.5 border border-dashed px-6 py-9"
				data-empty
				hidden
			>
				<h3 class="text-base font-semibold">Sin resultados</h3>
				<p class="max-w-full wrap-anywhere" data-empty-text></p>
				<p class="text-muted text-sm">Prueba con otra palabra o quita alguna tecnología.</p>
				<button
					class="bg-ink text-bg border-ink hover:bg-accent hover:border-accent hover:text-accent-ink min-h-10 cursor-pointer border px-3.5 py-2 text-sm font-medium"
					type="button"
					data-clear
				>
					Limpiar filtros
				</button>
			</div>
		</main>
	</div>
</Layout>

<script>
	import '../scripts/theme';
	import '../scripts/filters';
	import '../scripts/glow';
</script>
