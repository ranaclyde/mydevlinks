---
import LinkCard from '../components/LinkCard.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { localizePath, toLocale, useTranslations } from '../i18n/ui';
import Layout from '../layouts/Layout.astro';
import type { CategoryEntry } from '../lib/catalog';
import type { CATEGORIES } from '../lib/links';
import { absoluteUrl, categoryPath, linkPath, metaDescription, SITE_NAME } from '../lib/seo';
import { stateToSearch } from '../lib/url-state';

type Category = (typeof CATEGORIES)[number];

export interface Props {
	category: Category;
	entries: CategoryEntry[];
	/** Todas las categorías con enlaces, en el orden de `CATEGORIES`. */
	categories: { id: Category; count: number }[];
	/** Las descripciones de sus enlaces están en inglés. */
	translated: boolean;
	total: number;
}

const { category, entries, categories, translated, total } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const home = localizePath('/', locale);
const name = t.categories[category];
const intro = t.categoryIntro[category];
const count = entries.length;
const filterHref = home + stateToSearch({ query: '', category, tech: [], tag: null });
const crumbLink = 'underline underline-offset-3 transition-colors duration-100 hover:text-accent';
const action = 'text-[13px] underline underline-offset-3 transition-colors duration-100 hover:text-accent';

const path = categoryPath(category);
const url = absoluteUrl(localizePath(path, locale), Astro.site);
const description = metaDescription(intro, t.categoryMetaExtra(count));
const others = categories.filter((other) => other.id !== category);
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: t.directory, item: absoluteUrl(home, Astro.site) },
			{ '@type': 'ListItem', position: 2, name, item: url },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'CollectionPage',
		name: `${name} · ${SITE_NAME}`,
		url,
		inLanguage: locale,
		description,
		isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: absoluteUrl(home, Astro.site) },
		mainEntity: {
			'@type': 'ItemList',
			numberOfItems: count,
			itemListElement: entries.map(({ link }, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				name: link.name,
				url: absoluteUrl(localizePath(linkPath(link.id), locale), Astro.site),
			})),
		},
	},
];
---

<Layout
	title={`${name} · ${SITE_NAME}`}
	description={description}
	path={path}
	translated={translated}
	structuredData={structuredData}
>
	<SiteHeader total={total} path={path} animateLogo={false} />

	<main class="mx-auto max-w-[1240px] px-4 pt-4 pb-12 md:px-5 md:pt-5 md:pb-16">
		<nav aria-label={t.breadcrumb} class="text-muted mb-[18px] font-mono text-xs">
			<ol class="m-0 flex list-none flex-wrap gap-2 p-0">
				<li><a class={crumbLink} href={home} data-back>← {t.directory}</a></li>
				<li aria-hidden="true">/</li>
				<li aria-current="page">{name}</li>
			</ol>
		</nav>

		<header class="mb-5">
			<h1 class="text-[26px] leading-[1.15] font-semibold tracking-[-.01em] max-[520px]:text-[22px]">{name}</h1>
			<p class="mt-2.5 max-w-[68ch] text-base">{intro}</p>
			<div class="mt-3.5 flex flex-wrap items-baseline gap-x-4 gap-y-2">
				<p class="text-muted flex items-baseline gap-2 text-sm">
					<span class="text-ink font-mono text-[26px] leading-none font-semibold tabular-nums">{count}</span>
					<span>{t.links(count)}</span>
				</p>
				<a class={action} href={filterHref}>
					{t.filterInDirectory} <span aria-hidden="true">→</span>
				</a>
			</div>
		</header>

		<ul
			class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(min(270px,100%),1fr))] gap-3 p-0 max-md:grid-cols-1"
		>
			{entries.map(({ link, pricing }) => <LinkCard link={link} pricing={pricing} />)}
		</ul>

		{
			others.length > 0 && (
				<nav class="mt-10" aria-labelledby="otras-categorias">
					<h2 id="otras-categorias" class="text-[17px] leading-[1.3] font-semibold">
						{t.otherCategories}
					</h2>
					<ul class="m-0 mt-2.5 flex list-none flex-wrap gap-2 p-0">
						{others.map((other) => (
							<li>
								<a
									class="border-line bg-surface hover:border-accent hover:text-accent flex min-h-10 items-center gap-2 border px-3 py-1.5 text-sm transition-colors duration-100"
									href={localizePath(categoryPath(other.id), locale)}
								>
									{t.categories[other.id]}
									<span class="text-muted font-mono text-xs tabular-nums">{other.count}</span>
								</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}
	</main>
</Layout>

<script>
	import '../scripts/theme';
	import '../scripts/back';
	import '../scripts/glow';
</script>
