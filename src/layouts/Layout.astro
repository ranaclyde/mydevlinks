---
import '../styles/global.css';
import { DEFAULT_LOCALE, LOCALES, localizePath, OG_LOCALE, toLocale, useTranslations } from '../i18n/ui';
import { absoluteUrl, DEFAULT_OG_IMAGE, jsonLd, NO_INDEX, SITE_NAME } from '../lib/seo';

interface Props {
	title?: string;
	description?: string;
	/**
	 * Ruta de la página en español (/, /tool/<id>); la del idioma actual sale de ella.
	 * Sin ella la página no lleva canonical, og:url ni hreflang.
	 */
	path?: string;
	/**
	 * La página tiene todos sus textos en cada idioma. Sin eso no lleva hreflang, y la versión
	 * en un idioma que no es el de por defecto no se indexa: mostraría texto en español.
	 */
	translated?: boolean;
	image?: { path: string; width: number; height: number; alt: string };
	type?: 'website' | 'article';
	/** Datos estructurados de schema.org. */
	structuredData?: object[];
	noindex?: boolean;
}

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const {
	title = SITE_NAME,
	description = t.siteDescription,
	path,
	translated = true,
	image = { ...DEFAULT_OG_IMAGE, alt: t.ogAlt },
	type = 'website',
	structuredData = [],
	noindex = false,
} = Astro.props;

const canonical = path ? absoluteUrl(localizePath(path, locale), Astro.site) : undefined;
const imageUrl = absoluteUrl(image.path, Astro.site);
const hidden = noindex || NO_INDEX || (!translated && locale !== DEFAULT_LOCALE);
const robots = hidden ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const alternates =
	path && translated && !noindex
		? [
				...LOCALES.map((lang) => ({ hreflang: lang, href: absoluteUrl(localizePath(path, lang), Astro.site) })),
				{ hreflang: 'x-default', href: absoluteUrl(localizePath(path, DEFAULT_LOCALE), Astro.site) },
			]
		: [];
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		{canonical && <link rel="canonical" href={canonical} />}
		{alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
		<meta name="theme-color" content="#dfe3ee" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0e1014" media="(prefers-color-scheme: dark)" />
		<meta name="generator" content={Astro.generator} />

		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content={OG_LOCALE[locale]} />
		{alternates.length > 0 &&
			LOCALES.filter((lang) => lang !== locale).map((lang) => (
				<meta property="og:locale:alternate" content={OG_LOCALE[lang]} />
			))}
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content={String(image.width)} />
		<meta property="og:image:height" content={String(image.height)} />
		<meta property="og:image:alt" content={image.alt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={image.alt} />

		{structuredData.map((data) => <script type="application/ld+json" set:html={jsonLd(data)} />)}

		<script is:inline>
			document.documentElement.setAttribute('data-js', '');
			try {
				const theme = localStorage.getItem('mdl-theme');
				if (theme === 'light' || theme === 'dark') {
					document.documentElement.setAttribute('data-theme', theme);
				}
			} catch {
				// Sin acceso a localStorage se usa el tema del sistema.
			}
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
